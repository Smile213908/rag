# 云端 LLM 配置(此文件含密钥,勿提交/勿外发)
LLM_API_KEY=你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 数据目录
DATA_DIR=docs_data

# 检索参数
RECALL_TOP_N=50
RERANK_TOP_K=5
DENSE_WEIGHT=0.7

# 拒答阈值(reranker 最高分低于此值即拒答;评估集 v1 标定为 0.7)
REFUSE_THRESHOLD=0.7

# CRAG 质检(拒答第二层):1 开 0 关;关闭后退化为单层阈值
CRAG_CHECK=1
# 质检模型(可选,默认走快模型 FAST_LLM_MODEL;设回 k3 即恢复 M1 行为)
# CRAG_MODEL=kimi-for-coding

# 模型路由(M2):简单问题(高分短问题)走快模型降延迟
# FAST_LLM_MODEL=kimi-for-coding   # 快模型(默认 kimi-for-coding)
# ROUTE_MIN_SCORE=0.85             # 路由判据:top_score ≥ 此值
# ROUTE_MAX_QLEN=30                # 且问题长度 ≤ 此字数,才走快模型

# 计算设备(嵌入/精排模型):cpu(默认)/ cuda(GPU 机器,需 CUDA 版 torch)
# RAG_DEVICE=cpu

# 管理员初始密码(仅首次播种 admin 时读取;不设置则随机生成并打印一次)
# ADMIN_PASSWORD=

# 快模型生成长度封顶(M2 P1,默认 512;只对快模型生效,压端到端 token 硬下限)
# FAST_MAX_TOKENS=512
